# Runtime
NODE_ENV=development
PORT=3000
APP_NAME=ZITD
# Dashboard base URL used in email links (verify-email, reset-password)
APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Database
DATABASE_POOL_MAX=10
DATABASE_URL=postgres://postgres@127.0.0.1:5432/zitd_api
# Set to true for hosted Postgres that requires TLS (certificate must be valid)
DATABASE_SSL=false

# Tokens (generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-at-least-32-random-characters
# Minutes until an access token expires, or `never` for a token with no exp claim, which then lives as long as
# its session (revoked by logout or revoke-session, and gone after REFRESH_TOKEN_TTL_DAYS). Keep a short value
# in production; `never` is for local API poking.
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
TWO_FACTOR_CHALLENGE_TTL_SECONDS=300
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
REQUIRE_EMAIL_VERIFICATION=true

# Two-factor (32 bytes hex, generate with: openssl rand -hex 32)
TWO_FACTOR_ENCRYPTION_KEY=replace-with-64-hex-characters
TWO_FACTOR_ISSUER=ZITD

# Mail: log | smtp | memory. Production refuses anything but smtp, because
# log and memory print verification and reset tokens.
MAIL_DRIVER=log
MAIL_FROM="ZITD <no-reply@zitd.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# PostgreSQL outbox delivery: polling, initial retry backoff, and renewable worker lease
MAIL_OUTBOX_POLL_MS=1000
MAIL_OUTBOX_RETRY_MS=5000
MAIL_OUTBOX_LEASE_MS=120000

# Password blocklist. The bundled common-password list always applies. The breach check asks
# Have I Been Pwned using k-anonymity: only the first 5 characters of the SHA-1 hash are sent,
# never the password. It fails open, so an outage there cannot block registration.
PASSWORD_BREACH_CHECK=true
PASSWORD_BREACH_TIMEOUT_MS=2000

# Rate limiting (global defaults; credential endpoints are stricter)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# Operations
# true when behind a reverse proxy / load balancer, so session IPs come from X-Forwarded-For
TRUST_PROXY=false
# Swagger UI at /docs: on outside production unless set explicitly
# API_DOCS_ENABLED=false
